# ==============================================================================
# 🍽️ DABBA RESTAURANT APPLICATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Backend Server Port
PORT=5000

# MongoDB Database Connection String
# (If MongoDB is offline, the backend automatically falls back to data/local_db.json)
MONGO_URI=mongodb://127.0.0.1:27017/dabba_restaurant

# JWT Secret Key for Session Authentication & Token Signing
JWT_SECRET=dabba_super_secret_jwt_signature_key_2026

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development
